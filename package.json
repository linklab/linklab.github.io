{
  "name": "linklab-website",
  "private": true,
  "scripts": {
    "check:js": "biome check --error-on-warnings .",
    "fix:js": "biome check --write --error-on-warnings .",
    "check:js:structure": "ast-grep scan --rule .github/lint-rules/no-inline-javascript.yml --no-ignore hidden --no-ignore vcs _site",
    "check:css": "biome check --config-path=biome.css.json --error-on-warnings .",
    "fix:css": "biome check --config-path=biome.css.json --write --error-on-warnings .",
    "check:css:structure": "ast-grep scan --rule .github/lint-rules/no-inline-css.yml --no-ignore hidden --no-ignore vcs _site",
    "fix:html": "prettier --write \"**/*.html\"",
    "check:html": "prettier --check \"**/*.html\"",
    "check:html:structure": "html-validate \"_site/**/*.html\"",
    "fix:md": "md_status=0; markdownlint-cli2 --fix || md_status=$?; prettier --write \"**/*.md\" || md_status=$?; exit $md_status",
    "check:md": "prettier --check \"**/*.md\" && markdownlint-cli2"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@biomejs/biome": "2.6.4",
    "@shopify/prettier-plugin-liquid": "1.10.2",
    "html-validate": "11.17.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10"
  },
  "allowScripts": {
    "@ast-grep/cli@0.51.0": true
  },
  "overrides": {
    "markdownlint": {
      "re2js": "2.8.7"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
